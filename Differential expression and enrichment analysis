## Homotypic Doublet Proportion Estimate -------------------------------------------------------------------------------------
annotations_sl1w2 <- processed_saline1_2wk@meta.data$seurat_clusters
homotypic.prop_sl1w2 <- modelHomotypic(annotations_sl1w2)           ## ex: annotations <- seu_kidney@meta.data$ClusteringResults
