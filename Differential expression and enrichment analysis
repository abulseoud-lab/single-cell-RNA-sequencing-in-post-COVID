library(dplyr)
library(ggplot2)
library(scales)
library(grid)
 

kegg_up <- read.csv("data\\KEGG_results_2wk_neuron_up.csv")
kegg_down <- read.csv("data\\KEGG_results_2wk_neuron_down.csv")

# Number of pathways to show from each direction
top_n_each <- 16

# Use 0.05 to retain only statistically significant pathways.
# Use 1 to show pathways regardless of significance.
padj_cutoff <- 0.05


# Convert GeneRatio values such as "12/150" into numeric values
convert_gene_ratio <- function(x) {
  
  vapply(
    strsplit(as.character(x), "/"),
    function(z) {
      as.numeric(z[1]) / as.numeric(z[2])
    },
    numeric(1)
  )
}


# Activated/upregulated pathways
kegg_activated_df <- as.data.frame(kegg_up) %>%
  filter(
    !is.na(p.adjust),
    p.adjust <= padj_cutoff
  ) %>%
  slice_min(
    order_by = p.adjust,
    n = top_n_each,
    with_ties = FALSE
  ) %>%
  mutate(
    Direction = "of upregulated genes"
  )


# Suppressed/downregulated pathways
kegg_suppressed_df <- as.data.frame(kegg_down) %>%
  filter(
    !is.na(p.adjust),
    p.adjust <= padj_cutoff
  ) %>%
  slice_min(
    order_by = p.adjust,
    n = top_n_each,
    with_ties = FALSE
  ) %>%
  mutate(
    Direction = "of downregulated genes"
  )


# Combine the two enrichment results
kegg_combined <- bind_rows(
  kegg_activated_df,
  kegg_suppressed_df
)

if (nrow(kegg_combined) == 0) {
  stop("No KEGG pathways remain after adjusted P-value filtering.")
}


# Calculate numeric GeneRatio and -log10(adjusted P-value)
kegg_combined <- kegg_combined %>%
  mutate(
    GeneRatio_numeric = convert_gene_ratio(GeneRatio),
    
    # pmax prevents infinite values when p.adjust is reported as zero
    minus_log10_padj = -log10(
      pmax(p.adjust, .Machine$double.xmin)
    )
  )


# Order pathways according to their best adjusted P-value
pathway_order <- kegg_combined %>%
  group_by(Description) %>%
  summarise(
    best_p_adjust = min(p.adjust, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(desc(best_p_adjust)) %>%
  pull(Description)


kegg_combined <- kegg_combined %>%
  mutate(
    Direction = factor(
      Direction,
      levels = c("of upregulated genes", "of downregulated genes")
    ),
    
    Description = factor(
      Description,
      levels = unique(pathway_order)
    )
  )


# Use the same GeneRatio scale in both panels
gene_ratio_max <- max(
  kegg_combined$GeneRatio_numeric,
  na.rm = TRUE
)


# Create the KEGG bubble plot
kegg_bubble_plot <- ggplot(
  kegg_combined,
  aes(
    x = GeneRatio_numeric,
    y = Description
  )
) +
  geom_point(
    aes(
      size = Count,
      colour = minus_log10_padj
    ),
    alpha = 0.95
  ) +
  
  facet_grid(
    cols = vars(Direction)
  ) +
  
  scale_y_discrete(
    drop = FALSE
  ) +
  
  scale_x_continuous(
    limits = c(0, gene_ratio_max * 1.08),
    breaks = pretty_breaks(n = 4),
    expand = expansion(mult = c(0.01, 0.03))
  ) +
  
  scale_size_continuous(
    name = "Count",
    range = c(2.5, 8)
  ) +
  
  # Larger -log10 adjusted P-values indicate greater significance
  scale_colour_gradient(
    name = expression(-log[10]("adj. p-value")),
    low = "blue",
    high = "red"
  ) +
  
  labs(
    title = "Enriched Pathways",
    x = "GeneRatio",
    y = NULL
  ) +
  
  theme_bw(base_size = 10) +
  
  theme(
    plot.title = element_text(
      size = 12,
      hjust = 0.5
    ),
    
    strip.background = element_rect(
      fill = "white",
      colour = "grey50",
      linewidth = 0.5
    ),
    
    strip.text = element_text(
      size = 9,
      colour = "black"
    ),
    
    axis.title.x = element_text(
      size = 10,
      colour = "black"
    ),
    
    axis.text.x = element_text(
      size = 8,
      colour = "black"
    ),
    
    axis.text.y = element_text(
      size = 8,
      colour = "black"
    ),
    
    panel.grid.major = element_line(
      colour = "grey90",
      linewidth = 0.3
    ),
    
    panel.grid.minor = element_blank(),
    
    panel.spacing.x = unit(
      0.1,
      "cm"
    ),
    
    legend.position = "right",
    
    legend.title = element_text(
      size = 9
    ),
    
    legend.text = element_text(
      size = 8
    )
  ) +
  
  guides(
    size = guide_legend(
